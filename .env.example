NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:3000
# Use Supabase Session Pooler, port 5432, for IPv4. Keep a small pool.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&connection_limit=3
MIGRATION_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=finsight-private
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Select an NVIDIA-hosted chat model accessible to your account; no unverified default.
NVIDIA_CHAT_MODEL=
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_EMBEDDING_DIMENSIONS=1024
LOG_LEVEL=info
DEMO_MODE=false
# Development seed only. Never reuse these accounts for real financial data.
DEMO_SEED_PASSWORD=
# Browser-only synthetic preview. Set false when connecting the backend. Build-time variable.
NEXT_PUBLIC_DEMO_MODE=false
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_IMAGE=finsight-web:local
API_IMAGE=finsight-api:local
PUBLIC_IP=
ACME_EMAIL=
