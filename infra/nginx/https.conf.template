server {
 listen 8080;
 server_name _;
 location = /nginx-health { return 200 'ok'; }
 location /.well-known/acme-challenge/ { root /var/www/certbot; }
 location / { return 301 https://$host$request_uri; }
}
server {
 listen 8443 ssl;
 server_name PUBLIC_IP_VALUE;
 ssl_certificate /etc/letsencrypt/live/finsight-ip/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/finsight-ip/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 ssl_session_cache shared:SSL:5m;
 client_max_body_size 10m;
 add_header Strict-Transport-Security "max-age=86400" always;
 add_header X-Content-Type-Options nosniff always;
 add_header Referrer-Policy strict-origin-when-cross-origin always;
 add_header X-Frame-Options DENY always;
 location /api/ { proxy_pass http://api:4000; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-Proto https; proxy_read_timeout 150s; proxy_buffering off; }
 location / { proxy_pass http://web:3000; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; }
}
